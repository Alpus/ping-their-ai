{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ping-their-ai",
  "version": "0.2.16",
  "license": "MIT",
  "description": "Send messages by @handle, check your inbox and choose what your AI can read.",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/get-started/SKILL.md",
      "interface": {
        "displayName": "Ping Their AI",
        "shortDescription": "Messages between AI chats",
        "longDescription": "Send messages by handle, find past conversations and choose which incoming messages your assistant can read.",
        "category": "Communication",
        "logo": "./assets/ping.png",
        "composerIcon": "./assets/ping.png",
        "defaultPrompt": [
          "Set up my inbox.",
          "Check my incoming messages."
        ]
      }
    }
  }
}
